# FitPulse Environment Configuration

# Flask Secret Key
SECRET_KEY=fitpulse-super-secret-key-2026

# Base URL for canonical tags, OpenGraph, sitemap.xml, and robots.txt
# When testing locally: http://127.0.0.1:5000
# When hosted (e.g. Render / Railway / Supabase): https://your-app-name.onrender.com
SITE_BASE_URL=http://127.0.0.1:5000

# PostgreSQL Database URL
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
# Example Local: postgresql://postgres:postgres@localhost:5432/fitness_blog
# Example Supabase/Neon/Render: postgresql://user:password@ep-cool-db.us-east-1.aws.neon.tech/fitness_blog?sslmode=require
# NOTE: If left commented out or blank, the app gracefully falls back to local SQLite for instant testing!
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fitness_blog

# Google Search Console Verification Meta Tag (for college practical)
# Paste the token provided in Google Search Console -> URL Prefix -> HTML Tag verification
GOOGLE_SITE_VERIFICATION=google1234567890abcdef.html
